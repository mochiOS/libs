--- /dev/null
+++ b/src/syscfg/lock-obj-pub.x86_64-unknown-mochios.h
@@ -0,0 +1,14 @@
+## mochiOS POSIX lock ABI: derive layout and initializer from the target SDK.
+## No Linux sizes, alignment assumptions, or zero-initializer substitution.
+#include <pthread.h>
+typedef struct
+{
+  long _vers;
+  union {
+    pthread_mutex_t _native;
+    volatile char _priv[sizeof (pthread_mutex_t)];
+    long _x_align;
+    long *_xp_align;
+  } u;
+} gpgrt_lock_t;
+#define GPGRT_LOCK_INITIALIZER {1, {PTHREAD_MUTEX_INITIALIZER}}
