{
  "format": 1,
  "backend": "meson",
  "options": {
    "platforms": "[]",
    "gallium-drivers": "softpipe",
    "vulkan-drivers": "[]",
    "egl": "enabled",
    "gles1": "disabled",
    "gles2": "enabled",
    "opengl": false,
    "glx": "disabled",
    "gbm": "disabled",
    "glvnd": "disabled",
    "llvm": "disabled",
    "draw-use-llvm": false,
    "shader-cache": "disabled",
    "build-tests": false,
    "tools": "[]",
    "gallium-va": "disabled",
    "gallium-mediafoundation": "disabled",
    "gallium-rusticl": false,
    "valgrind": "disabled",
    "libunwind": "disabled",
    "lmsensors": "disabled",
    "allow-kcmp": "disabled",
    "display-info": "disabled",
    "xmlconfig": "disabled",
    "expat": "disabled",
    "zstd": "disabled",
    "zlib": "disabled"
  },
  "install_tags": [
    "runtime",
    "devel"
  ],
  "licenses": [
    "docs/license.rst",
    "licenses/Apache-2.0",
    "licenses/BSL-1.0",
    "licenses/MIT",
    "licenses/SGI-B-2.0"
  ],
  "shared_libraries": [
    "libEGL.so*",
    "libGLESv2.so*",
    "libgallium-*.so"
  ],
  "link_libraries": [
    "EGL",
    "GLESv2"
  ],
  "pkg_config_modules": [
    "egl",
    "glesv2"
  ],
  "probe": "probe.c",
  "patches": [
    "mochios.patch"
  ]
}
