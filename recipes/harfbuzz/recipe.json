{
  "format": 1,
  "backend": "meson",
  "options": {
    "glib": "enabled",
    "freetype": "enabled",
    "icu": "enabled",
    "icu_builtin": false,
    "gobject": "disabled",
    "cairo": "disabled",
    "chafa": "disabled",
    "png": "disabled",
    "zlib": "disabled",
    "introspection": "disabled",
    "docs": "disabled",
    "tests": "disabled",
    "utilities": "disabled",
    "benchmark": "disabled",
    "subset": "disabled",
    "raster": "disabled",
    "vector": "disabled",
    "gpu": "disabled",
    "gpu_demo": "disabled"
  },
  "install_tags": [
    "runtime",
    "devel"
  ],
  "licenses": [
    "COPYING"
  ],
  "shared_libraries": [
    "libharfbuzz.so*",
    "libharfbuzz-icu.so*"
  ],
  "link_libraries": [
    "harfbuzz",
    "harfbuzz-icu"
  ],
  "pkg_config_modules": [
    "harfbuzz",
    "harfbuzz-icu"
  ],
  "probe": "probe.c"
}
