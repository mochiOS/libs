diff --git a/Source/WTF/wtf/PlatformOS.h b/Source/WTF/wtf/PlatformOS.h
--- a/Source/WTF/wtf/PlatformOS.h
+++ b/Source/WTF/wtf/PlatformOS.h
@@ -112,6 +112,11 @@
 #define WTF_OS_LINUX 1
 #endif
 
+/* OS(MOCHIOS) - mochiOS native ABI, not a Linux compatibility target. */
+#if defined(__mochios__)
+#define WTF_OS_MOCHIOS 1
+#endif
+
 /* OS(NETBSD) - NetBSD */
 #if defined(__NetBSD__)
 #define WTF_OS_NETBSD 1
diff --git a/Source/WTF/wtf/StackBounds.cpp b/Source/WTF/wtf/StackBounds.cpp
--- a/Source/WTF/wtf/StackBounds.cpp
+++ b/Source/WTF/wtf/StackBounds.cpp
@@ -122,7 +122,12 @@
     pthread_attr_get_np(thread, &sattr);
 #else
     // FIXME: this function is non-portable; other POSIX systems may have different np alternatives
+#if OS(MOCHIOS)
+    // An unsupported/missing native stack query must not become a guessed bound.
+    RELEASE_ASSERT(!pthread_getattr_np(thread, &sattr));
+#else
     pthread_getattr_np(thread, &sattr);
+#endif
 #endif
     int rc = pthread_attr_getstack(&sattr, &bound, &stackSize);
     UNUSED_PARAM(rc);
diff --git a/Source/WebCore/platform/unix/SharedMemoryUnix.cpp b/Source/WebCore/platform/unix/SharedMemoryUnix.cpp
--- a/Source/WebCore/platform/unix/SharedMemoryUnix.cpp
+++ b/Source/WebCore/platform/unix/SharedMemoryUnix.cpp
@@ -108,7 +108,12 @@
         tempName = name.utf8();
 
         do {
+            // Do not truncate or reuse another process's named object on collision.
+#if OS(MOCHIOS)
+            fileDescriptor = shm_open(tempName.data(), O_CREAT | O_EXCL | O_RDWR, S_IRUSR | S_IWUSR);
+#else
             fileDescriptor = shm_open(tempName.data(), O_CREAT | O_RDWR, S_IRUSR | S_IWUSR);
+#endif
         } while (fileDescriptor == -1 && errno == EINTR);
     }
 
