{
  "format": 1,
  "backend": "meson",
  "options": {
    "enable-x11": false,
    "enable-wayland": false,
    "enable-xkbregistry": false,
    "enable-tools": false,
    "enable-docs": false,
    "enable-bash-completion": false,
    "enable-tests": false
  },
  "install_tags": ["runtime", "devel"],
  "licenses": ["LICENSE"],
  "shared_libraries": ["libxkbcommon.so*"],
  "link_libraries": ["xkbcommon"],
  "pkg_config_modules": ["xkbcommon"],
  "probe": "probe.c",
  "patches": ["mochios.patch"]
}
