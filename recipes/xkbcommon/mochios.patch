--- /dev/null
+++ b/src/mochios-secure-env.h
@@ -0,0 +1,24 @@
+/* The SDK declares secure_getenv but shared.4 does not export it. Keep the
+ * upstream secure default using real auxiliary/credential APIs; never silently
+ * substitute getenv when security information is missing or credentials differ. */
+#pragma once
+#include <errno.h>
+#include <stdlib.h>
+#include <sys/auxv.h>
+#include <sys/types.h>
+#include <unistd.h>
+static inline char *xkb_mochios_secure_getenv(const char *name) {
+    if (!name) return NULL;
+    const int saved_errno = errno;
+    errno = 0;
+    const unsigned long secure = getauxval(AT_SECURE);
+    int allowed = errno == 0 && secure == 0;
+    if (allowed) {
+        const uid_t uid = getuid(), euid = geteuid();
+        const gid_t gid = getgid(), egid = getegid();
+        allowed = uid != (uid_t)-1 && euid != (uid_t)-1 &&
+                  gid != (gid_t)-1 && egid != (gid_t)-1 && uid == euid && gid == egid;
+    }
+    errno = saved_errno;
+    return allowed ? getenv(name) : NULL;
+}
