+project('glib-networking-mochios', 'c', version: '2.90.1', meson_version: '>= 0.60.0',
+        default_options: ['c_std=gnu11', 'warning_level=1'])
+cc = meson.get_compiler('c')
+gio = dependency('gio-2.0', version: '>= 2.80')
+gmodule = dependency('gmodule-2.0')
+# This archive owns no socket or process runtime. All Rust internals must stay
+# private to this DSO; it cannot be linked directly into the C process image.
+if not cc.has_header('mochios/tls.h')
+  error('This provider requires an SDK with the native TLS record archive')
+endif
+# find_library() links an executable, which is invalid for this private PIC archive.
+# The real shared-library link below is the availability/import check.
+tls_engine = declare_dependency(link_args: ['-lmochios_tls_pic'])
+conf = configuration_data()
+conf.set_quoted('GETTEXT_PACKAGE', 'glib-networking')
+conf.set('ENABLE_DEBUG_LOGS', 0)
+conf.set('GLIB_NETWORKING_STATIC_COMPILATION', 1)
+configure_file(output: 'config.h', configuration: conf)
+args = ['-D_GNU_SOURCE', '-fvisibility=hidden', '-Wno-deprecated-declarations']
+# Avoid colliding with an alternate installed GIO backend in host tests.
+foreach name : ['GTlsConnectionBase', 'GTlsConnectionBaseClass', 'GTlsConnectionBasePrivate',
+                'GTlsConnectionBase_private_offset', 'GTlsInputStream', 'GTlsInputStreamClass',
+                'GTlsOutputStream', 'GTlsOutputStreamClass']
+  args += '-D' + name + '=' + name.replace('GTls', 'GTlsMochios')
+endforeach
+base = files('../base/gtlsconnection-base.c', '../base/gtlsinputstream.c', '../base/gtlslog.c',
+             '../base/gtlsoutputstream.c', '../base/gtlssessioncache.c', '../base/gtlsutils.c')
+module = shared_library('giomochios', 'backend.c', base,
+  include_directories: include_directories('.', '../base'),
+  dependencies: [gio, gmodule, tls_engine], c_args: args,
+  link_args: ['-Wl,--version-script=' + meson.current_source_dir() / 'exports.map'],
+  link_depends: 'exports.map', install: true, install_tag: 'runtime')
+# Constructors register the provider before GIO first looks up its backend.
+# --no-as-needed is necessary even when the app only calls generic GIO APIs.
+pkg = import('pkgconfig')
+pkg.generate(name: 'Native mochiOS GIO TLS', filebase: 'gio-mochios-tls',
+  description: 'Verified TLS 1.3 client provider using the mochiOS record engine',
+  version: meson.project_version(),
+  requires: ['gio-2.0'], libraries: ['-L${libdir}', '-Wl,--no-as-needed', '-lgiomochios', '-Wl,--as-needed'])
